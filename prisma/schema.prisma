// BOOKS AND NOTES CG BOARD - Prisma schema
// Deploy target: Vercel + Supabase (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Content hierarchy ----------
model Medium {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  icon      String?
  color     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  classes   Class[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id        String   @id @default(cuid())
  name      String
  code      String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  mediumId  String
  medium    Medium   @relation(fields: [mediumId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// type: "book" | "notes" | "other"
model Book {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("book")
  coverUrl    String?
  pdfUrl      String
  fileSize    Int?
  pages       Int?
  author      String?
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- App chrome (admin controlled) ----------
model SidebarItem {
  id        String   @id @default(cuid())
  label     String
  icon      String
  linkType  String   @default("screen") // "screen" | "external"
  linkValue String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SplashSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  duration  Int      @default(3000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BottomNavItem {
  id        String   @id @default(cuid())
  label     String
  icon      String
  screen    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Monetization ----------
// network: "admob" | "facebook"
model AdConfig {
  id                   String  @id @default(cuid())
  network              String  @default("admob")
  enabled              Boolean @default(false)
  appId                String?
  bannerAdUnitId       String?
  interstitialAdUnitId String?
  nativeAdUnitId       String?
  rewardedAdUnitId     String?
  appOpenAdUnitId      String?
  bannerEnabled        Boolean @default(false)
  interstitialEnabled  Boolean @default(false)
  nativeEnabled        Boolean @default(false)
  rewardedEnabled      Boolean @default(false)
  appOpenEnabled       Boolean @default(false)
  interstitialInterval Int     @default(3)
  testMode             Boolean @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ---------- Notifications ----------
model NotificationConfig {
  id             String   @id @default(cuid())
  enabled        Boolean  @default(false)
  onesignalAppId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------- Generic key/value settings ----------
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

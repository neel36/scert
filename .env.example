# ============================================================
# BOOKS AND NOTES CG BOARD — Environment variables
# ============================================================
# Copy this file to `.env` for local development.
# On Vercel, set these in: Project Settings → Environment Variables.
# ------------------------------------------------------------

# ---- Database (Supabase PostgreSQL) ----
# Standard connection string / Transaction pooler string from Supabase project settings
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[your-region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---- Node env ----
NODE_ENV="development"

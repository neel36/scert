# ============================================================
# BOOKS AND NOTES CG BOARD — Environment variables
# ============================================================
# Copy this file to `.env` for local development.
# On Vercel, set these in: Project Settings → Environment Variables.
# ------------------------------------------------------------

# ---- Database ----
# LOCAL DEV (SQLite file):
DATABASE_URL="file:./db/custom.db"
# VERCEL PRODUCTION (Turso libSQL):
#   1. Create a free Turso DB:  https://turso.tech
#   2. turso db create cg-board
#   3. turso db show cg-board --url          ->  DATABASE_URL
#   4. turso db tokens create cg-board       ->  DATABASE_AUTH_TOKEN
# DATABASE_URL="libsql://cg-board-<your-username>.turso.io"
# DATABASE_AUTH_TOKEN="eyJhbGciOi..."

# ---- Node env ----
NODE_ENV="development"
